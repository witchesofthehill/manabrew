---
import Default from "@astrojs/starlight/components/Head.astro";
import preset, { cssVars } from "../theme";

const css = `:root{color-scheme:dark;${cssVars(preset.dark)}} :root[data-theme="light"]{color-scheme:light;${cssVars(preset.light)}}`;
---

<Default><slot /></Default>
<Fragment set:html={`<style>${css}</style>`} />
