+    ) {
+        let presentation = self.manabrew_entry_presentations.get(owner.index())
+            .and_then(|sections| sections.get(section))
+            .and_then(|entries| entries.get(entry_index));
+        if let (Some(presentation), Some(object)) = (presentation, self.game.object(id)) {
+            self.manabrew_presentations.insert(object.stable_id.0.0, presentation.clone());
+        }
+    }
+
+    fn manabrew_presentation_is_visible(&self, stable_id: u64, viewer: Option<PlayerId>) -> bool {
+        self.game.find_object_by_stable_id(StableId::from_raw(stable_id))
+            .is_some_and(|id| !self.game.is_face_down(id) && self.manabrew_card_is_visible(id, viewer))
+    }
+
+    fn decorate_manabrew_cards(&self, value: &mut Value, viewer: Option<PlayerId>) {
+        match value {
+            Value::Array(values) => {
+                for value in values {
+                    self.decorate_manabrew_cards(value, viewer);
+                }
+            }
+            Value::Object(fields) => {
+                let card_id = fields.get("id").and_then(Value::as_str);
+                let stack_source = card_id
+                    .and_then(|id| id.strip_prefix("stack-"))
+                    .and_then(|id| id.rsplit_once('-'))
+                    .and_then(|(_, index)| index.parse::<usize>().ok())
+                    .and_then(|index| self.game.stack.get(index))
+                    .filter(|entry| !entry.is_ability || entry.source_snapshot.as_ref()
+                        .is_none_or(|snapshot| !snapshot.face_down))
+                    .and_then(|_| fields.get("sourceId").and_then(Value::as_str));
+                let stable_id = card_id.filter(|_| fields.contains_key("ownerId"))
+                    .and_then(|id| id.strip_prefix("card-"))
+                    .or_else(|| stack_source.and_then(|id| id.strip_prefix("card-")))
+                    .and_then(|id| id.parse::<u64>().ok());
+                if fields.contains_key("identity") {
+                    if let Some(stable_id) = stable_id {
+                        if self.manabrew_presentation_is_visible(stable_id, viewer) {
+                            if let Some(presentation) = self.manabrew_presentations.get(&stable_id) {
+                                if let Some(identity) = fields.get_mut("identity").and_then(Value::as_object_mut) {
+                                    identity.insert("setCode".into(), Value::String(presentation.set_code.clone()));
+                                    identity.insert("cardNumber".into(), Value::String(presentation.card_number.clone()));
+                                }
+                                fields.insert("foil".into(), Value::Bool(presentation.foil.unwrap_or(false)));
