{
 "uid": "manabrew-live-ops",
 "title": "Manabrew \u2014 Live Ops",
 "tags": [
  "manabrew",
  "ops"
 ],
 "schemaVersion": 39,
 "editable": true,
 "timezone": "utc",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "30s",
 "links": [
  {
   "title": "Executive Health",
   "type": "link",
   "url": "/d/manabrew-executive"
  },
  {
   "title": "Engagement & Gameplay",
   "type": "link",
   "url": "/d/manabrew-engagement"
  },
  {
   "title": "Decks & Collections",
   "type": "link",
   "url": "/d/manabrew-decks-collections"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Humans connected",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(manabrew_relay_connections{kind=\"human\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Games in progress",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(manabrew_relay_rooms{status=\"in_game\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
