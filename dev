#!/bin/sh
set -eu

COMPOSE="compose.dev.yaml"

case "${1:-}" in
  start)
    docker compose -f "$COMPOSE" up -d --build --remove-orphans
    echo "==> waiting for hub migrations (a cold start compiles first)"
    i=0
    until docker compose -f "$COMPOSE" logs hub 2>/dev/null | grep -q "migration ran"; do
      if [ "$i" -ge 150 ]; then
        echo "==> still no migration log; follow it with ./dev logs"
        exit 0
      fi
      i=$((i + 1))
      sleep 2
    done
    docker compose -f "$COMPOSE" logs hub 2>/dev/null | grep "migration ran"
    ;;
  logs) docker compose -f "$COMPOSE" logs -f ;;
  stop) docker compose -f "$COMPOSE" down ;;
  clean)
    docker compose -f "$COMPOSE" down -v --remove-orphans
    echo "==> purged containers and volumes: hub.db, cargo caches, node_modules"
    ;;
  *) echo "Usage: ./dev {start|logs|stop|clean}"; exit 1 ;;
esac
