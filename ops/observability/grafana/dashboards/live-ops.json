{
  "uid": "manabrew-live-ops",
  "title": "Manabrew \u2014 Live Ops",
  "tags": ["manabrew", "ops"],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "utc",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "Executive Health",
      "type": "link",
      "url": "/d/manabrew-executive"
    },
    {
      "title": "Engagement & Gameplay",
      "type": "link",
      "url": "/d/manabrew-engagement"
    },
    {
      "title": "Decks & Collections",
      "type": "link",
      "url": "/d/manabrew-decks-collections"
    },
    {
      "title": "Engine Health",
      "type": "link",
      "url": "/d/manabrew-engine-health"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Humans connected",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(manabrew_relay_connections{kind=\"human\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Games in progress",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(manabrew_relay_rooms{status=\"in_game\"} or vector(0)) + sum(manabrew_relay_local_games or vector(0))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Relay rooms in game plus games running on players' own machines. A solo game opens no room, so the relay only counts it because the client says so; a player with no connection is not counted at all."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hosted rooms (node)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(manabrew_node_rooms_hosted)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Node push age (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(push_time_seconds{job=\"self-hosted-node\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Analytics events dropped",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(manabrew_relay_analytics_dropped_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Node versions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "manabrew_node_build_info",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connections by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (manabrew_relay_connections)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rooms by status / hosted",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status, hosted) (manabrew_relay_rooms)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{status}} hosted={{hosted}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Games started / ended (per hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(manabrew_relay_games_started_total[1h])) * 3600",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "started"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(manabrew_relay_games_ended_total[1h])) * 3600",
          "legendFormat": "ended: {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Client rejections by reason (per hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(manabrew_relay_client_rejections_total[1h])) * 3600",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Engine errors by signature (10m increase)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (signature) (increase(manabrew_node_engine_errors_total[10m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{signature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {},
      "description": "no series until the first engine error occurs"
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Hosted game duration p50 / p95 (s, per-node summary)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(manabrew_node_game_duration_seconds{quantile=\"0.5\"})",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(manabrew_node_game_duration_seconds{quantile=\"0.95\"})",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Reconnect resyncs (per hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(manabrew_relay_reconnect_resyncs_total[1h])) * 3600",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "resyncs"
        },
        {
          "refId": "B",
          "expr": "sum(rate(manabrew_node_relay_reconnects_total[1h])) * 3600",
          "legendFormat": "node reconnects",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Warnings & errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"manabrew-server|manabrew-hub|self-hosted-node|events-ingester\"} |~ \"WARN|ERROR|panicked|failed\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Stuck-room signal \u2014 abandoned reaps per 2h (alert > 6)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(manabrew_relay_games_ended_total{reason=\"abandoned\"}[2h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "abandoned reaps (2h window)"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (increase(manabrew_relay_games_ended_total{reason!=\"abandoned\"}[2h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{reason}} (context)"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Deck-play events dropped",
      "description": "relay-to-Hub evidence events lost since the relay started",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(manabrew_relay_deck_play_events_dropped_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Hub analytics age",
      "description": "seconds since the last successful sanitized Hub export",
      "gridPos": {
        "x": 18,
        "y": 36,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "events-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT strftime('%s', 'now') - coalesce((SELECT strftime('%s', synced_at) FROM hub_sync_state WHERE id = 1), 0) AS seconds",
          "rawQueryText": "SELECT strftime('%s', 'now') - coalesce((SELECT strftime('%s', synced_at) FROM hub_sync_state WHERE id = 1), 0) AS seconds",
          "queryType": "table",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "30-day records",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Lobby players record",
      "description": "highest number of connected human player seats waiting in lobbies during Prometheus retention",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((sum(manabrew_relay_players{kind=\"human\",status=\"lobby\"}))[30d:])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Concurrent games record",
      "description": "highest number of games running at the same time during Prometheus retention, relay rooms and solo games together",
      "gridPos": {
        "x": 6,
        "y": 45,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((sum(manabrew_relay_rooms{status=\"in_game\"} or vector(0)) + sum(manabrew_relay_local_games or vector(0)))[30d:])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Connected humans record",
      "description": "highest number of human relay connections at the same time during Prometheus retention",
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((sum(manabrew_relay_connections{kind=\"human\"}))[30d:])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Open rooms record",
      "description": "highest number of lobby and in-game rooms open at the same time during Prometheus retention",
      "gridPos": {
        "x": 18,
        "y": 45,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((sum(manabrew_relay_rooms))[30d:])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Solo games in progress",
      "description": "Games running on a player's own machine, by kind. Counted only for clients connected to the relay, so treat it as a floor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (manabrew_relay_local_games)",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 24,
      "type": "row",
      "title": "Relay network",
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Client RTT",
      "description": "Relay-to-client round trip measured from WebSocket ping/pong payload echoes on the relay clock.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "manabrew_relay_client_rtt_ms{quantile=\"0.5\"}",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "manabrew_relay_client_rtt_ms{quantile=\"0.9\"}",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "manabrew_relay_client_rtt_ms{quantile=\"0.99\"}",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "WebSocket payload throughput",
      "description": "Application payload bytes crossing the relay. Excludes WebSocket framing, TLS, TCP, and IP overhead.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 56,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(manabrew_relay_websocket_payload_bytes_total[5m]))",
          "legendFormat": "{{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 27,
      "type": "stat",
      "title": "WebSocket payload transferred",
      "description": "Payload transferred during the selected dashboard range, split by direction. This is the lower bound for billed network transfer because protocol overhead is excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 56,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (increase(manabrew_relay_websocket_payload_bytes_total[$__range]))",
          "legendFormat": "{{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
