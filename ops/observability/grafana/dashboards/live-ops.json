   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Node push age (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(push_time_seconds{job=\"self-hosted-node\"})",
