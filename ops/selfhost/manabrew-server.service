# See README.md. Fill the art cache once with `manabrew-server --download-art`.
[Unit]
Description=Manabrew relay
After=network-online.target
Wants=network-online.target

[Service]
User=manabrew
Group=manabrew
StateDirectory=manabrew
ExecStart=/usr/local/bin/manabrew-server
Environment=MANABREW_ART_DIR=/var/lib/manabrew
# Answer mDNS, so the desktops on this network find this box on their own.
Environment=MANABREW_LAN_ADVERTISE=1
Restart=always
RestartSec=2

# The network and its own state directory, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
