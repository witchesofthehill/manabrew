+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+enum ManabrewCardFinish { Regular, Gloss, Etched, Prismatic, Cold, Opal, Rain, Heat, Pool }
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+enum ManabrewCardFrame { Printing, Modern, Retro }
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+enum ManabrewCardBorder { Printing, Black, White, Silver }
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+enum ManabrewCardWear { Fresh, Light, Played, Heavy }
+
+fn manabrew_entry_presentations(
+    decks: &[Value],
+) -> Result<Vec<BTreeMap<String, Vec<ManabrewCardPresentation>>>, JsValue> {
+    decks.iter().map(|deck| {
+        ["cards", "sideboard", "commanders"].into_iter().map(|section| {
+            let entries = array_value(object_value(deck).get(section)).iter()
+                .filter(|card| manabrew_card_name(card).is_some())
+                .map(|card| {
+                    let identity = card.get("identity").unwrap_or(card);
+                    let mut presentation: ManabrewCardPresentation = serde_json::from_value(identity.clone())
+                        .map_err(|error| JsValue::from_str(&format!("invalid card presentation: {error}")))?;
+                    presentation.cosmetics = presentation.cosmetics.and_then(ManabrewCardCosmetics::normalized);
+                    Ok::<_, JsValue>(presentation)
+                })
+                .collect::<Result<Vec<_>, _>>()?;
+            Ok((section.to_string(), entries))
+        }).collect()
+    }).collect()
+}
