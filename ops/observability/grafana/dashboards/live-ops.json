  {
   "id": 100,
   "type": "row",
   "title": "Engine health (#684 watch)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 101,
   "type": "timeseries",
   "title": "Engine stopped by GC (fraction of wall clock)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 50,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (instance) (rate(manabrew_node_engine_gc_pause_millis_total[5m])) / 1000",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.05
       },
       {
        "color": "red",
        "value": 0.2
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "dashed"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Cumulative GC pause over wall clock. #684 was 89% stopped: back to back full collections in an exhausted heap. One isolate hosts every room on a node, so this stops all of them together. Sustained above a few percent is that failure returning."
  },
  {
   "id": 102,
   "type": "timeseries",
   "title": "Engine heap used vs ceiling",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 50,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (instance) (manabrew_node_engine_heap_used_bytes / manabrew_node_engine_heap_max_bytes)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{instance}} used/max"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.75
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "dashed"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "The ceiling is baked into the image as a percentage of the cgroup limit, so mem_limit is the knob. Live set approaching it is what precedes the thrash; retention grows with the union of decks a node has hosted (#703)."
  },
  {
   "id": 103,
   "type": "timeseries",
   "title": "Decision stages p99 (where the time goes)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 58,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (stage) (manabrew_node_forge_decision_stage_seconds{quantile=\"0.99\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{stage}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "description": "decision_total splits into the stages. In the 2026-08 stalls decision_total and next_prompt were identical to the millisecond, which puts the time inside Forge producing the next question rather than in the bridge, the submit, or state serialisation."
  },
  {
   "id": 104,
   "type": "timeseries",
   "title": "Player round trip (relay heartbeat echo)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 58,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "manabrew_relay_client_rtt_ms{quantile=\"0.5\"}",
     "datasource": {
      "type": "prometheus",
