+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct ManabrewCardPresentation {
+    #[serde(default)]
+    set_code: String,
+    #[serde(default)]
+    card_number: String,
+    #[serde(default)]
+    foil: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    cosmetics: Option<ManabrewCardCosmetics>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ManabrewCardCosmetics {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    finish: Option<ManabrewCardFinish>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    frame: Option<ManabrewCardFrame>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    border: Option<ManabrewCardBorder>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    wear: Option<ManabrewCardWear>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    wear_seed: Option<u32>,
+}
+
+impl ManabrewCardCosmetics {
+    fn normalized(mut self) -> Option<Self> {
+        if matches!(self.frame, Some(ManabrewCardFrame::Printing)) {
+            self.frame = None;
+        }
+        if matches!(self.border, Some(ManabrewCardBorder::Printing)) {
+            self.border = None;
+        }
+        if matches!(self.wear, Some(ManabrewCardWear::Fresh)) {
+            self.wear = None;
+        }
+        if self.wear.is_none() || self.wear_seed == Some(0) {
+            self.wear_seed = None;
+        }
+        (self.finish.is_some() || self.frame.is_some() || self.border.is_some()
+            || self.wear.is_some()).then_some(self)
+    }
+}
