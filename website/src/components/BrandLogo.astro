---
import sprite from "../../../images/brand/logos/interactive/manabrew-logo.svg?url";
import geometry from "../../../src/assets/brandLogoGeometry.json";
import "../../../src/components/layout/ManaBrewLogo.css";

interface Props {
  variant?: "horizontal" | "symbol";
  height?: number;
  mode?: "light" | "dark" | "auto";
  decorative?: boolean;
}

const { variant = "horizontal", height = 64, mode = "dark", decorative = false } = Astro.props;
const dimensions = geometry[variant];
const width = (height * dimensions.width) / dimensions.height;
const modes = mode === "auto" ? ["light", "dark"] : [mode];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class="mb-logo"
  data-mode={mode}
  viewBox={dimensions.viewBox}
  width={width}
  height={height}
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : "Manabrew"}
  aria-hidden={decorative ? "true" : undefined}
  focusable="false"
>
  {modes.map((logoMode) => (
    <use
      class={mode === "auto" ? (logoMode === "light" ? "mb-logo-light" : "mb-logo-dark") : undefined}
      href={`${sprite}#mb-${variant}-${logoMode}`}
    />
  ))}
</svg>
