  {
   "id": 9,
   "type": "timeseries",
   "title": "Games started / ended (per hour)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(manabrew_relay_games_started_total[1h])) * 3600",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "started"
    },
    {
     "refId": "B",
     "expr": "sum by (reason) (rate(manabrew_relay_games_ended_total[1h])) * 3600",
     "legendFormat": "ended: {{reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
