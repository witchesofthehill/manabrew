# Edge config for the `ingress` service (compose.production.yml): owns 80/443
# and TLS for every host, and only ever proxies. The web container serves the
# three static sites behind it (ops/web.Caddyfile). Recreating any app
# container leaves ingress up, so a web rollout no longer severs the relay's
# live websockets. Config changes apply via `caddy reload` in
# `cargo xtask deploy`, never a recreate.
manabrew.app {
    reverse_proxy manabrew:80
}

play.manabrew.app {
    reverse_proxy manabrew:80
}

docs.manabrew.app {
    reverse_proxy manabrew:80
}

relay.manabrew.app {
    reverse_proxy manabrew-server:9443 {
        health_uri /health
        health_port 9444
        health_interval 15s
        health_timeout 3s
    }
}

# Deck hub + stats API. HUB_ADMIN_PASSWORD_HASH unset → the placeholder
# default matches no password: /admin/* is locked, not broken config.
api.manabrew.app {
    @admin path /admin/*
    basic_auth @admin {
        admin {$HUB_ADMIN_PASSWORD_HASH:$2y$05$ln9aIQ9AeSFyHiuO0tKm1uXmTi0/DYR0HPN/nEsp184AWyvGvc7hu}
    }
    reverse_proxy manabrew-hub:9500 {
        health_uri /health
        health_interval 1s
        health_timeout 3s
        lb_try_duration 30s
        lb_try_interval 250ms
    }
}

# Staging slot (compose.staging.yml under /opt/manabrew-staging, same docker
# network) — deployed from the `staging` branch by staging-deploy.yml. 502s
# while the slot is down.
staging.manabrew.app {
    reverse_proxy manabrew-staging:80
}

relay-staging.manabrew.app {
    reverse_proxy manabrew-server-staging:9443 {
        health_uri /health
        health_port 9444
        health_interval 15s
        health_timeout 3s
    }
}

# Observability ingress (`observability` compose profile). PUSHGATEWAY_PASSWORD_HASH
# unset → the placeholder default matches no password: locked, not broken config.
grafana.manabrew.app {
    reverse_proxy grafana:3000
}

push.manabrew.app {
    basic_auth {
        metrics {$PUSHGATEWAY_PASSWORD_HASH:$2y$05$ln9aIQ9AeSFyHiuO0tKm1uXmTi0/DYR0HPN/nEsp184AWyvGvc7hu}
    }
    reverse_proxy pushgateway:9091
}

loki.manabrew.app {
    basic_auth {
        metrics {$PUSHGATEWAY_PASSWORD_HASH:$2y$05$ln9aIQ9AeSFyHiuO0tKm1uXmTi0/DYR0HPN/nEsp184AWyvGvc7hu}
    }
    reverse_proxy loki:3100
}

telemetry.manabrew.app {
    log {
        output discard
    }

    @collect {
        path /collect
        method POST OPTIONS
        header_regexp Origin ^(https://(play|staging)\.manabrew\.app|https://manabrew\.app|tauri://localhost|https?://tauri\.localhost|http://(localhost|127\.0\.0\.1):9527)$
    }
    handle @collect {
        request_body {
            max_size 256KiB
        }
        @preflight method OPTIONS
        handle @preflight {
            header Access-Control-Allow-Origin "{http.request.header.Origin}"
            header Access-Control-Allow-Methods "POST"
            header Access-Control-Allow-Headers "Content-Type, X-Faro-Session-Id, Idempotency-Key"
            header Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
            respond "" 204
        }
        reverse_proxy faro-collector:12347 {
            header_up -Forwarded
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -Cookie
            header_up -Authorization
            header_down Access-Control-Allow-Headers "Content-Type, X-Faro-Session-Id, Idempotency-Key"
            header_down Access-Control-Allow-Methods "POST"
        }
    }
    @collection_path path /collect
    handle @collection_path {
        respond "Forbidden" 403
    }
    handle {
        respond "Not found" 404
    }
    handle_errors {
        respond "Collector request failed" {err.status_code}
    }
}
