+                                    fields.insert("cosmetics".into(), serde_json::to_value(cosmetics)
+                                        .expect("typed card cosmetics are serializable"));
+                                }
+                            }
+                        }
+                    }
+                }
+                for value in fields.values_mut() {
+                    self.decorate_manabrew_cards(value, viewer);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn manabrew_view_to_js(
+        &self,
+        value: &impl Serialize,
+        viewer: Option<PlayerId>,
+        label: &str,
+    ) -> Result<JsValue, JsValue> {
+        let mut value = serde_json::to_value(value)
+            .map_err(|error| JsValue::from_str(&format!("failed to encode {label}: {error}")))?;
+        self.decorate_manabrew_cards(&mut value, viewer);
+        manabrew_to_js(&value, label)
+    }
